---
layout: layouts/base.njk
---

{# Breadcrumb #}
{% include 'layouts/blocks/breadcrumbs.njk' %}

{# Title band #}
{% if title %}
<div class="product-title-band">
  <div class="product-title-row">
    <h1 class="product-name">{{ title }}</h1>
  </div>
  {% if description %}
  <p class="product-tagline">{{ description }}</p>
  {% endif %}
</div>
{% endif %}

{# Content #}
<div class="page-content">
  {{ content | safe }}
</div>

{# Prev / Next navigation #}
{% if prevPost.url or nextPost.url %}
<div class="section-rule">
  <span class="section-num"></span>
  <span class="section-label">
    {% if prevPost.url %}<a href="{{ prevPost.url }}">← {{ prevPost.data.title }}</a>{% endif %}
    {% if nextPost.url %}<a href="{{ nextPost.url }}" style="margin-left:auto">{{ nextPost.data.title }} →</a>{% endif %}
  </span>
</div>
{% endif %}
