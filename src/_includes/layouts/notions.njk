---
layout: layouts/base.njk
---

{# Breadcrumb #}
{% include 'layouts/blocks/breadcrumbs.njk' %}

{# Title band #}
<div class="project-title-band">
  <h1 class="project-title-name">{{ title }}</h1>
  {% if tagline %}
  <p class="project-title-tagline">{{ tagline }}</p>
  {% endif %}
  {% if description %}
  <p class="project-title-desc">{{ description }}</p>
  {% endif %}
  {% if links %}
  <div class="project-action-links">
    {% for link in links %}
    <a href="{{ link.url }}"
       class="{% if loop.first %}action-link-primary{% else %}action-link-ghost{% endif %}"
       target="_blank" rel="noopener">
      {{ link.label }}
    </a>
    {% endfor %}
  </div>
  {% endif %}
</div>

{# Product listing #}
<div class="section-rule">
  <span class="section-num">001</span>
  <span class="section-label">notions</span>
</div>

<section class="notions-section">
  <div class="notions-grid">
    {%- for post in collections['cord accessories'] -%}
    <article class="notion-card">
      <div class="project-meta-row">
        <span class="project-index">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
        {%- if post.data.icon -%}
        <span class="project-status">{{ post.data.icon }}</span>
        {%- endif -%}
      </div>
      <a href="{{ post.url }}">
        <div class="notion-thumb">
          {%- if post.data.galleryPath -%}
            {%- set cardImages = post.data.galleryPath | getProductImages -%}
            {%- if cardImages and cardImages.length > 0 -%}
              {% image cardImages[0], post.data.title, "(max-width: 600px) 100vw, 50vw", [600] %}
            {%- else -%}
              <div class="notion-thumb-placeholder">{{ post.data.icon or '—' }}</div>
            {%- endif -%}
          {%- elif post.data.images and post.data.images.length > 0 -%}
            <img src="{{ post.data.images[0] }}" alt="{{ post.data.title }}" loading="lazy">
          {%- else -%}
            <div class="notion-thumb-placeholder">{{ post.data.icon or '—' }}</div>
          {%- endif -%}
        </div>
      </a>
      <h2 class="notion-name">
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </h2>
      {% if post.data.description %}
      <p class="notion-desc">{{ post.data.description }}</p>
      {% endif %}
      <a href="{{ post.url }}" class="notion-cta">View →</a>
    </article>
    {%- endfor -%}
  </div>
</section>

{# Body content if any #}
{% if content | trim | length > 0 %}
<div class="page-content">{{ content | safe }}</div>
{% endif %}
