---
layout: layouts/base.njk
---

{# Resolve image list #}
{% set localImages = galleryPath | getProductImages %}
{% if localImages and localImages.length > 0 %}
  {% set allImages = localImages %}
{% elif images and images.length > 0 %}
  {% set allImages = images %}
{% else %}
  {% set allImages = [] %}
{% endif %}

{# Breadcrumb #}
{% include 'layouts/blocks/breadcrumbs.njk' %}

{# Title band #}
<div class="product-title-band">
  <div class="product-title-row">
    <h1 class="product-name">{{ title }}</h1>
    {% if status %}
    <span class="product-status">{{ status }}</span>
    {% endif %}
  </div>
  {% if tagline %}
  <p class="product-tagline">{{ tagline }}</p>
  {% endif %}
</div>

{# Two-column body #}
<div class="product-body">

  {# Left: image gallery #}
  <div class="product-image-col">
    <div class="product-main-image" id="product-main-image">
      {% if allImages.length > 0 %}
        {% for imgPath in allImages %}
          <div class="product-main-slide{% if loop.first %}{% else %} product-main-slide--hidden{% endif %}" data-slide="{{ loop.index0 }}">
            {% image imgPath, title + " — image " + loop.index, "(max-width: 600px) 100vw, 60vw", [600, 1200] %}
          </div>
        {% endfor %}
      {% else %}
        <div class="project-thumb-placeholder">{{ icon or title }}</div>
      {% endif %}
    </div>

    {% if allImages.length > 1 %}
    <div class="product-thumbnails" id="product-thumbnails">
      {% for imgPath in allImages %}
      <button class="product-thumb{% if loop.first %} active{% endif %}"
              data-index="{{ loop.index0 }}"
              aria-label="View image {{ loop.index }}">
        {% image imgPath, title + " — thumbnail " + loop.index, "100px", [100, 200] %}
      </button>
      {% endfor %}
    </div>
    {% endif %}
  </div>

  {# Right: sidebar #}
  <div class="product-sidebar">
    {% if icon %}
    <div class="product-icon-row">
      <span class="product-icon">{{ icon }}</span>
      <span class="product-icon-label">{{ title }}</span>
    </div>
    {% endif %}

    {% if description %}
    <p class="product-description">{{ description }}</p>
    {% endif %}

    {% if links %}
    <div class="sidebar-rule"></div>
    <div>
      <p class="product-links-heading">Downloads &amp; Links</p>
      <ul class="product-links-list">
        {% for link in links %}
        <li>
          <a href="{{ link.url }}" target="_blank" rel="noopener">
            {% if link.icon %}<span style="font-size:11px;color:var(--gray3)">{{ link.icon }}</span>{% endif %}
            {{ link.label }}
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>

</div>

{# Specs #}
{% if specs %}
<div class="section-rule">
  <span class="section-num">002</span>
  <span class="section-label">specifications</span>
</div>
<div class="product-specs-section">
  <div class="product-specs-grid">
    {% for spec in specs %}
    <div class="spec-item">
      <p class="spec-label">{{ spec.label }}</p>
      <p class="spec-value">{{ spec.value }}</p>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}

{# Tags #}
{% if tags %}
{% set visibleTags = [] %}
{% for tag in tags %}
  {% if tag != 'products' and tag != 'projects' and tag != 'notions' %}
    {% set visibleTags = (visibleTags.push(tag), visibleTags) %}
  {% endif %}
{% endfor %}
{% if visibleTags.length > 0 %}
<div class="section-rule">
  <span class="section-num"></span>
  <span class="section-label">tags</span>
</div>
<div class="product-tags-section">
  {% for tag in tags %}
    {% if tag != 'products' and tag != 'projects' and tag != 'notions' %}
    <span class="product-tag">{{ tag }}</span>
    {% endif %}
  {% endfor %}
</div>
{% endif %}
{% endif %}

{# Body content if any #}
{% if content | trim | length > 0 %}
<div class="page-content">{{ content | safe }}</div>
{% endif %}

{# Gallery JS — show/hide slides on thumbnail click #}
{% if allImages.length > 1 %}
<script>
(function() {
  var mainWrap = document.getElementById('product-main-image');
  var thumbBtns = document.querySelectorAll('.product-thumb');

  thumbBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      thumbBtns.forEach(function(t) { t.classList.remove('active'); });
      btn.classList.add('active');

      var idx = btn.getAttribute('data-index');
      mainWrap.querySelectorAll('.product-main-slide').forEach(function(slide) {
        if (slide.getAttribute('data-slide') === idx) {
          slide.classList.remove('product-main-slide--hidden');
        } else {
          slide.classList.add('product-main-slide--hidden');
        }
      });
    });
  });
})();
</script>
{% endif %}
